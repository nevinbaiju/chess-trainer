# Copy to .env and fill in. .env is gitignored.

# The key your LiteLLM gateway expects. The coach is the only thing that uses
# it; without it the app still runs and falls back to template explanations.
LITELLM_MASTER_KEY=

# Model alias defined in your LiteLLM config.
COACH_MODEL=chess-coach

# The compose network your LiteLLM gateway is on. The container joins it to
# reach the gateway by service name, because a gateway bound to 127.0.0.1 on
# the host is not reachable through host.containers.internal.
LITELLM_NETWORK=litellm_default

# Where the SQLite database lives on the host.
CHESS_DATA=./data/chess-trainer

# chess.com answer 403 to an empty User-Agent and ask that it carry a way to
# reach you. Put your own address here before importing games.
CHESSCOM_USER_AGENT=chess-trainer/0.1 (you@example.com)

# --- tuning (all optional, defaults in compose.yaml) ---
# OPPONENT_TEMPERATURE=1.0   # 0 = argmax = plays ABOVE its rating label
# REVIEW_DEPTH=16
# STOCKFISH_THREADS=2
# CHESS_CPUS=3.0
# CHESS_WIN_PCT_K=-0.002     # -0.00368208 reproduces lichess exactly
# DNS_PRIMARY=1.1.1.1
# DNS_SECONDARY=8.8.8.8
